---
// FaqSection.astro
// Component แสดง FAQ
const { faq } = Astro.props;
---

{Array.isArray(faq) && faq.length > 0 && (
  <section class="faq-section">
    <h2>คำถามที่พบบ่อย (FAQ)</h2>
    <div class="faq-list">
      {faq.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <div class="answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}
