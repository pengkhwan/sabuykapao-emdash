---
// src/pages/etc.astro
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import '../styles/pages/_category-page.scss';
import { client } from '../lib/sanityClient.js';
import { generateCollectionSchema } from '../lib/schema/generateCollectionSchema.js';
import { mapProductsToSchema } from '../lib/schema/mapProductToSchema.js';

// ===== Listing config =====
const CATEGORY_SLUG = 'etc';
const PAGE_SIZE = 28; // 28 ชิ้นต่อหน้า

// ดึงข้อมูล SEO จาก Sanity
const categoryQuery = `*[_type == "category" && slug.current == $cat][0]{
  title,
  description,
  categoryHeader,
  categoryDetails[],
  seo {
    seoTitle,
    seoDescription,
    ogTitle,
    ogDescription,
    ogImage
  }
}`;
const categoryData = await client.fetch(categoryQuery, { cat: CATEGORY_SLUG });

// นับทั้งหมดเพื่อคำนวณจำนวนหน้า
const countQuery = `count(*[_type == "product" && $cat in categories[]->slug.current])`;
const total = await client.fetch(countQuery, { cat: CATEGORY_SLUG });
const totalPages = Math.max(1, Math.ceil((Number(total) || 0) / PAGE_SIZE));

// ดึง "เฟรมแรก" 16 ชิ้น (SSG เสมอ) — หน้าอื่นโหลดด้วย JSON (client)
const itemsQuery = `*[_type == "product" && $cat in categories[]->slug.current]
  | order(_createdAt desc)
  [0...$limit]{
    name,                                // ✅ ใช้ name ให้ตรงกับสคีมา Sanity
    price,
    "imageUrl": image.asset->url,
    "alt": coalesce(image.alt, name),
    "slug": slug.current,
    shortDescription
  }`;
const products = await client.fetch(itemsQuery, { cat: CATEGORY_SLUG, limit: PAGE_SIZE });

// ===== JSON-LD (ใช้ตัวสร้างสคีมากลาง) =====
const site = Astro.site?.href || 'https://sabuykapao.com';
const pageUrl =
  (typeof Astro.url?.href === 'string' && Astro.url.href) ||
  (site ? `${site.replace(/\/$/, '')}${Astro.url.pathname}` : Astro.url.pathname);

// ใช้ SEO data จาก Sanity หรือ fallback เป็นข้อมูลเดิม
const pageTitle = categoryData?.seo?.seoTitle || categoryData?.title || "สินค้าเครื่องหนัง-จิปาถะ | SabuyKapao";
const pageDesc = categoryData?.seo?.seoDescription || categoryData?.description || "รวมเครื่องหนังหลากหลาย เช่น ซองแว่นตา, กระเป๋าใส่นามบัตร, สายคล้องแมส ทุกชิ้นทำจากหนังแท้เกรด A คุณภาพสูง";
// OG Image: ใช้ SEO image จาก Sanity หรือ fallback เป็นรูปสินค้าชิ้นแรก
const pageOgImage = categoryData?.seo?.ogImage?.asset?.url || products?.[0]?.imageUrl;

const breadcrumb = [
  { name: "หน้าแรก", url: "/" },
  { name: "สินค้าเครื่องหนัง-จิปาถะ", url: "/etc" },
];

// ใช้ reusable function สำหรับแปลง products เป็น schema format
// รองรับ dynamic data และ pagination อัตโนมัติ (จำกัดแค่ 16 ชิ้นแรก)
const items = mapProductsToSchema(products, site, 16);

const schema = generateCollectionSchema({
  pageType: "productCategory",
  site,
  pageTitle,
  pageDescription: pageDesc,
  pageUrl,
  breadcrumb,
  items,
});
---
<Layout 
  title={pageTitle}
  description={pageDesc}
  ogImage={pageOgImage}
  ogType="website"
>
  <Fragment slot="head">
    {/* JSON-LD: CollectionPage + BreadcrumbList + ItemList(Product) */}
    <script type="application/ld+json" set:html={schema} />
    <!-- Preconnect to Sanity CDN -->
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <!-- Preload first product image for LCP -->
    {products[0]?.imageUrl && (
      <link 
        rel="preload" 
        as="image" 
        href={`${products[0].imageUrl}?w=300&h=300&fit=crop&q=90&auto=format`}
        imagesrcset={`
          ${products[0].imageUrl}?w=180&h=180&fit=crop&q=90&auto=format 180w,
          ${products[0].imageUrl}?w=300&h=300&fit=crop&q=90&auto=format 300w
        `}
        imagesizes="(max-width: 640px) 180px, (max-width: 1024px) 240px, 300px"
        fetchpriority="high" 
      />
    )}
  </Fragment>

  <main class="category-page">
    <div class="container">
      <div class="category-header">
        <h1>{categoryData?.categoryHeader?.title || 'สินค้าเครื่องหนัง-จิปาถะ'}</h1>
        <p>{categoryData?.categoryHeader?.description || 'รวมเครื่องหนังหลากหลายไว้ให้เลือกซื้อในราคาถูก เหมาะสำหรับเป็นของฝาก ทุกชิ้นทำจากหนังแท้เกรด A ทำให้มั่นใจในเรื่องของคุณภาพสินค้า'}</p>
      </div>

      <div class="product-grid-container">
        {/* เติม data-list เพื่อให้ listing-controls.js ทำงาน โดยไม่เปลี่ยนโครง DOM */}
        <div class="product-grid" data-list>
          {(Array.isArray(products) ? products : []).map((product, index) => (
            <a href={`/${product.slug}`} class="product-card" data-slug={product.slug}>
              <div class="product-card__image-wrapper">
                {product.imageUrl && (
                  <img
                    src={`${product.imageUrl}?w=300&h=300&fit=crop&q=90&auto=format`}
                    srcset={`
                      ${product.imageUrl}?w=180&h=180&fit=crop&q=90&auto=format 180w,
                      ${product.imageUrl}?w=300&h=300&fit=crop&q=90&auto=format 300w
                    `}
                    sizes="(max-width: 640px) 180px, (max-width: 1024px) 240px, 300px"
                    alt={product.alt || product.name}
                    width="300"
                    height="300"
                    loading={index < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={index < 3 ? 'high' : 'auto'}
                  />
                )}
              </div>
              <div class="product-card__info">
                <h3 class="product-card__name">{product.name}</h3>
                {typeof product.price === 'number'
                  ? <p class="product-card__price">{new Intl.NumberFormat('th-TH').format(product.price)} บาท</p>
                  : <p class="product-card__price">—</p>}
              </div>
            </a>
          ))}
        </div>
      </div>


      {categoryData?.categoryDetails && categoryData.categoryDetails.length > 0 && (
        <div class="category-description">
          {categoryData.categoryDetails.map((section) => (
            <>
              <h2>{section.heading}</h2>
              <p>{section.content}</p>
            </>
          ))}
        </div>
      )}
    </div>
  </main>
</Layout>
