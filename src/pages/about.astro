---
// src/pages/about.astro
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import '../styles/pages/_about.scss';
import { client } from '../lib/sanityClient.js';
import { urlFor } from '../lib/sanityImageUrl.js';

// --- นำเข้ารูปภาพ (Default Fallback) ---
import heroImage from '../assets/images/about/about-hero.webp';
import materialsImage from '../assets/images/about/about-materials.webp';
import craftsmanshipImage from '../assets/images/about/about-craftsmanship.webp';

// --- Fetch Data from Sanity ---
const aboutPageQuery = `*[_type == "aboutPage"][0]{
  headerTitle,
  headerDescription,
  headerImage,
  philosophyTitle,
  philosophyItems[]{
    title,
    description,
    icon
  },
  materialsTitle,
  materialsList[]{
    title,
    description
  },
  materialsImage,
  craftsmanshipTitle,
  craftsmanshipList[]{
    title,
    description
  },
  craftsmanshipImage,
  seoTitle,
  seoDescription,
  ogImage{
    asset->{
      url
    }
  }
}`;

const aboutPageData = await client.fetch(aboutPageQuery);

// --- Icon Mapping ---
const iconMap = {
  quality: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>`,
  design: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" /></svg>`,
  detail: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>`,
  default: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>`
};

// --- ข้อมูลสำหรับ Section ต่างๆ (Fallback / Default) ---
const defaultPhilosophyItems = [
    {
        icon: iconMap.quality,
        title: "คัดสรรคุณภาพ",
        text: "เราเริ่มต้นจากวัตถุดิบที่ดีที่สุด คัดเลือกหนังวัวแท้เกรดพรีเมียมที่ทั้งสวยงามและทนทาน"
    },
    {
        icon: iconMap.design,
        title: "ออกแบบเฉพาะคุณ",
        text: "ผลงานหลายชิ้นของเราสามารถปรับเปลี่ยนและใส่รายละเอียดเฉพาะตัว เช่น การตอกชื่อหรือโลโก้"
    },
    {
        icon: iconMap.detail,
        title: "ใส่ใจทุกรายละเอียด",
        text: "เราเชื่อว่าคุณค่าของงานแฮนด์เมดคือความใส่ใจ เราจึงดูแลทุกขั้นตอนการผลิตด้วยตัวเอง"
    }
];

// --- Prepare Data ---
const philosophyItems = aboutPageData?.philosophyItems?.map((item: any) => ({
  icon: iconMap[item.icon as keyof typeof iconMap] || iconMap.default,
  title: item.title,
  text: item.description
})) || defaultPhilosophyItems;

// --- Image Logic ---
let heroImgSrc: any = heroImage;
let heroImgAlt = "บรรยากาศร้าน SabuyKapao";
if (aboutPageData?.headerImage) {
  heroImgSrc = urlFor(aboutPageData.headerImage).width(500).quality(95).url();
  heroImgAlt = aboutPageData.headerImage.alt || heroImgAlt;
}

let materialsImgSrc: any = materialsImage;
let materialsImgAlt = "หนังวัวแท้คุณภาพสูง";
if (aboutPageData?.materialsImage) {
  materialsImgSrc = urlFor(aboutPageData.materialsImage).width(500).quality(95).url();
  materialsImgAlt = aboutPageData.materialsImage.alt || materialsImgAlt;
}

let craftsmanshipImgSrc: any = craftsmanshipImage;
let craftsmanshipImgAlt = "การเย็บเครื่องหนังด้วยมือ";
if (aboutPageData?.craftsmanshipImage) {
  craftsmanshipImgSrc = urlFor(aboutPageData.craftsmanshipImage).width(500).quality(95).url();
  craftsmanshipImgAlt = aboutPageData.craftsmanshipImage.alt || craftsmanshipImgAlt;
}

const pageTitle = aboutPageData?.seoTitle || "เกี่ยวกับเรา | SabuyKapao";
const pageDescription = aboutPageData?.seoDescription || "เรื่องราวและปรัชญาของ SabuyKapao เรามุ่งมั่นสร้างสรรค์เครื่องหนังแท้แฮนด์เมดคุณภาพสูง ที่สะท้อนตัวตนและคงความงดงามเหนือกาลเวลา";
const pageOgImage = aboutPageData?.ogImage?.asset?.url;

const pageSchema = {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": new URL(Astro.url.pathname, Astro.site).href,
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  ogImage={pageOgImage}
>
  <Fragment slot="head">
    <!-- Preconnect to Sanity CDN -->
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <!-- Preload hero image for LCP -->
    {aboutPageData?.headerImage && (
      <link 
        rel="preload" 
        as="image" 
        href={urlFor(aboutPageData.headerImage).width(500).quality(95).url()} 
        imagesrcset={`
          ${urlFor(aboutPageData.headerImage).width(250).quality(95).url()} 250w,
          ${urlFor(aboutPageData.headerImage).width(400).quality(95).url()} 400w,
          ${urlFor(aboutPageData.headerImage).width(500).quality(95).url()} 500w
        `}
        imagesizes="(max-width: 640px) 350px, 500px"
        fetchpriority="high" 
      />
    )}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "AboutPage",
          "@id": "https://sabuykapao.com/about#webpage",
          "url": "https://sabuykapao.com/about",
          "name": pageTitle,
          "description": pageDescription,
          "image": typeof heroImgSrc === 'string' ? heroImgSrc : (aboutPageData?.headerImage ? urlFor(aboutPageData.headerImage).width(1200).quality(90).url() : heroImage.src),
          "isPartOf": { "@id": "https://sabuykapao.com/#website" },
          "breadcrumb": { "@id": "https://sabuykapao.com/about#breadcrumb" },
          "mainEntity": { "@id": "https://sabuykapao.com/#organization" }
        },
        {
          "@type": "Organization",
          "@id": "https://sabuykapao.com/#organization",
          "name": "SabuyKapao",
          "url": "https://sabuykapao.com/",
          "logo": "https://sabuykapao.com/sabuykapao-logo.svg",
          "image": typeof heroImgSrc === 'string' ? heroImgSrc : (aboutPageData?.headerImage ? urlFor(aboutPageData.headerImage).width(1200).quality(90).url() : heroImage.src),
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+66-84-095-4445",
            "contactType": "Customer Service"
          },
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "337/2 หมู่ 4 ทางหลวงแผ่นดินหมายเลข 325, ตำบลดอนกรวย",
            "addressLocality": "ดำเนินสะดวก",
            "addressRegion": "ราชบุรี",
            "postalCode": "70130",
            "addressCountry": "TH"
          },
          "sameAs": [
            "https://www.facebook.com/sabuykapao",
            "https://line.me/ti/p/@sabuykapao",
            "https://www.tiktok.com/@sabuykapao",
            "https://shopee.co.th/sabuykapao"
          ]
        },
        {
          "@type": "BreadcrumbList",
          "@id": "https://sabuykapao.com/about#breadcrumb",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "หน้าแรก",
              "item": "https://sabuykapao.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "เกี่ยวกับเรา",
              "item": "https://sabuykapao.com/about"
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <main class="about-page">
    <section class="about-hero">
      <div class="container about-hero__grid">
        <div class="about-hero__image">
          {typeof heroImgSrc === 'string' ? (
            <img 
              src={heroImgSrc} 
              srcset={aboutPageData?.headerImage ? `
                ${urlFor(aboutPageData.headerImage).width(250).quality(95).url()} 250w,
                ${urlFor(aboutPageData.headerImage).width(400).quality(95).url()} 400w,
                ${urlFor(aboutPageData.headerImage).width(500).quality(95).url()} 500w
              ` : undefined}
              sizes="(max-width: 640px) 350px, 500px"
              alt={heroImgAlt} 
              width="500" 
              height="500" 
              loading="eager" 
              decoding="async" 
              fetchpriority="high" 
              style="border-radius: 12px; width: 100%; height: auto;" 
            />
          ) : (
            <Image src={heroImgSrc} alt={heroImgAlt} width={800} height={600} format="webp" quality={90} loading="eager" />
          )}
        </div>
        <div class="about-hero__content">
          <h1>{aboutPageData?.headerTitle || "เรื่องราวของเรา"}</h1>
          <p>
            {aboutPageData?.headerDescription || "SabuyKapao ถือกำเนิดขึ้นจากความหลงใหลในเสน่ห์ของเครื่องหนังแท้ เราเชื่อว่าเครื่องหนังไม่ใช่แค่เครื่องประดับ แต่เป็นเพื่อนร่วมเดินทางที่เก็บเรื่องราวและสะท้อนตัวตนของผู้ใช้งาน เราจึงมุ่งมั่นสร้างสรรค์ผลงานแฮนด์เมดคุณภาพสูง ที่ผสมผสานระหว่างดีไซน์ที่เรียบง่ายแต่โดดเด่น กับความทนทานที่พร้อมจะอยู่กับคุณไปตราบนานเท่านาน"}
          </p>
        </div>
      </div>
    </section>

    <section class="philosophy-section">
      <div class="container">
        <div class="section-header">
          <h2>{aboutPageData?.philosophyTitle || "มากกว่างานฝีมือ คือปรัชญาของเรา"}</h2>
        </div>
        <div class="philosophy-grid">
          {philosophyItems.map((item: any) => (
            <div class="philosophy-card">
              <div class="philosophy-card__icon" set:html={item.icon} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="feature-section">
      <div class="container feature-section__grid">
        <div class="feature-section__image">
          {typeof materialsImgSrc === 'string' ? (
            <img src={materialsImgSrc} alt={materialsImgAlt} width="400" height="400" loading="lazy" decoding="async" style="border-radius: 12px; width: 100%; height: auto;" />
          ) : (
            <Image src={materialsImgSrc} alt={materialsImgAlt} width={800} height={800} format="webp" quality={90} />
          )}
        </div>
        <div class="feature-section__content">
          <h2>{aboutPageData?.materialsTitle || "วัตถุดิบที่เราเลือก"}</h2>
          <ul>
            {aboutPageData?.materialsList ? (
              aboutPageData.materialsList.map((item: any) => (
                <li><strong>{item.title}:</strong> {item.description}</li>
              ))
            ) : (
              <>
                <li><strong>หนังวัวแท้ 100%:</strong> เราใช้หนังวัวฟอกฝาดและหนังออยล์ที่ขึ้นชื่อเรื่องความทนทานและลวดลายที่เป็นเอกลักษณ์ตามธรรมชาติ</li>
                <li><strong>ยิ่งใช้ ยิ่งสวย:</strong> เสน่ห์ของหนังแท้คือร่องรอยตามกาลเวลา (Aging) ที่จะทำให้ชิ้นงานของคุณสวยงามและมีเรื่องราวมากขึ้น</li>
              </>
            )}
          </ul>
        </div>
      </div>
    </section>

    <section class="feature-section">
      <div class="container feature-section__grid reverse">
        <div class="feature-section__image">
          {typeof craftsmanshipImgSrc === 'string' ? (
            <img src={craftsmanshipImgSrc} alt={craftsmanshipImgAlt} width="400" height="400" loading="lazy" decoding="async" style="border-radius: 12px; width: 100%; height: auto;" />
          ) : (
            <Image src={craftsmanshipImgSrc} alt={craftsmanshipImgAlt} width={800} height={800} format="webp" quality={90} />
          )}
        </div>
        <div class="feature-section__content">
          <h2>{aboutPageData?.craftsmanshipTitle || "ความประณีตในทุกฝีเข็ม"}</h2>
          <ul>
            {aboutPageData?.craftsmanshipList ? (
              aboutPageData.craftsmanshipList.map((item: any) => (
                <li><strong>{item.title}:</strong> {item.description}</li>
              ))
            ) : (
              <>
                <li><strong>งานเย็บมือ (Hand-Stitched):</strong> เราบรรจงเย็บทุกฝีเข็มด้วยมือเพื่อความแข็งแรงและสวยงามที่เป็นเอกลักษณ์ซึ่งงานจักรไม่สามารถเทียบได้</li>
                <li><strong>ออกแบบและผลิตเอง:</strong> ทุกขั้นตอนตั้งแต่การออกแบบ, ตัดเย็บ, จนถึงการเก็บรายละเอียด เราดูแลด้วยตัวเองเพื่อให้ได้คุณภาพที่ดีที่สุด</li>
              </>
            )}
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>