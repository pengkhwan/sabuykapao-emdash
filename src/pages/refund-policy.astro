---
// src/pages/refund-policy.astro
import Layout from '../layouts/Layout.astro';

const pageSchema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "นโยบายการเปลี่ยนสินค้าและรับประกัน - SabuyKapao",
    "description": "นโยบายการรับประกันสินค้า SabuyKapao รับประกันความผิดพลาดจากการผลิต 30 วัน",
    "url": new URL(Astro.url.pathname, Astro.site).href,
};
---

<Layout 
  title="นโยบายการเปลี่ยนสินค้าและรับประกัน - SabuyKapao"
  description="นโยบายการรับประกันสินค้า SabuyKapao รับประกันความผิดพลาดจากการผลิต 30 วัน"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <main class="refund-page">
    <div class="container">
      <div class="content-wrapper">
        <header class="page-header">
          <h1>นโยบายการเปลี่ยนสินค้าและรับประกัน</h1>
          <p class="last-updated">อัปเดตล่าสุด: 23 มกราคม 2569</p>
        </header>

        <div class="content-body">
          <p class="intro">
            SabuyKapao ให้ความสำคัญกับคุณภาพของสินค้าทุกชิ้น ก่อนจัดส่งเรามีการตรวจสอบคุณภาพ (QC) 
            อย่างละเอียด แต่เพื่อให้ท่านมั่นใจ เรามีนโยบายการดูแลดังนี้
          </p>

          <section class="policy-section">
            <h2>1. การเปลี่ยน/คืนเงิน (ภายใน 7-15 วัน)</h2>
            <p>
              เนื่องจากท่านสั่งซื้อผ่านแพลตฟอร์ม Marketplace (Shopee, Lazada, TikTok, LINE Shopping) 
              การเปลี่ยนหรือคืนสินค้าให้ยึดตาม <strong>"กฎของแพลตฟอร์มนั้นๆ"</strong> เป็นหลัก
            </p>
            <ul class="custom-list">
              <li>
                <strong>กรณีสินค้าเสียหาย/ส่งผิด:</strong> ให้กด "ขอคืนเงิน/คืนสินค้า" 
                ในระบบของแพลตฟอร์มทันทีภายในระยะเวลาที่กำหนด (ห้ามกดรับสินค้าก่อนตรวจสอบ)
              </li>
              <li>
                <strong>กรณีเปลี่ยนใจ:</strong> สินค้าต้องอยู่ในสภาพสมบูรณ์ 100% ไม่ผ่านการใช้งาน 
                และไม่แกะป้ายสินค้า (หากแกะใช้แล้ว ขอสงวนสิทธิ์ไม่รับคืนทุกกรณี)
              </li>
            </ul>
          </section>

          <section class="policy-section">
            <h2>2. การรับประกันสินค้า (30 วัน)</h2>
            <p>
              เรารับประกันคุณภาพสินค้าเป็นระยะเวลา <strong>30 วัน</strong> นับจากวันที่ได้รับสินค้า 
              โดยครอบคลุมเฉพาะ <strong>"ความผิดพลาดจากการผลิต"</strong> เท่านั้น
            </p>
            <ul class="custom-list">
              <li>
                <strong>สิ่งที่รับประกัน (เคลมฟรี):</strong> ด้ายหลุด, ตะเข็บแตก, อะไหล่หลุด 
                หรือชำรุดเสียหายที่เกิดจากตัวสินค้าเองตั้งแต่แกะกล่อง
              </li>
              <li>
                <strong>สิ่งที่ไม่รับประกัน:</strong>
                <ul>
                  <li>รอยขีดข่วนหรือรอยยับตามธรรมชาติของหนังแท้</li>
                  <li>ความเสียหายจากการใช้งานผิดประเภท (เช่น ใส่ของหนักเกินไป, โดนน้ำ, โดนสารเคมี)</li>
                  <li>ความเสื่อมสภาพตามการใช้งานปกติ (Wear and Tear)</li>
                </ul>
              </li>
            </ul>
          </section>

          <section class="policy-section">
            <h2>3. บริการซ่อมแซม (หลังหมดประกัน 30 วัน)</h2>
            <p>
              หากสินค้าเสียหายหลังจากหมดระยะเวลาประกัน 30 วัน ท่านยังสามารถส่งมาให้เราดูแลซ่อมแซมได้ 
              โดยทางร้านจะ <strong>"ประเมินค่าใช้จ่ายตามจริง"</strong> (เช่น ค่าอะไหล่, ค่าแรง, ค่าจัดส่ง) 
              ก่อนดำเนินการซ่อม
            </p>
          </section>

          <section class="policy-section">
            <h2>4. ช่องทางการแจ้งปัญหา</h2>
            <p>
              หากพบปัญหา สามารถติดต่อทีมงานพร้อมแนบรูปภาพ/วิดีโอหลักฐาน ได้ที่:
              <br/>
              <strong>Facebook Page / LINE OA ของร้าน</strong>
            </p>
          </section>

          <div class="note-box">
             **หมายเหตุ:** การตัดสินของทางร้านถือเป็นที่สิ้นสุด
          </div>

        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .refund-page {
    background-color: #FAFAF9;
    min-height: 100vh;
    padding: 3rem 0;
    font-family: 'Sarabun', sans-serif;
  }

  .content-wrapper {
    max-width: 48rem;
    margin: 0 auto;
    background: #FFFFFF;
    padding: 2rem;
    border-radius: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);

    @media (min-width: 768px) {
      padding: 3rem;
    }
  }

  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid #E7E5E4;
    padding-bottom: 2rem;

    h1 {
      font-size: 1.875rem;
      font-weight: 800;
      color: #8B5E3C;
      margin-bottom: 0.75rem;
      line-height: 1.2;

      @media (min-width: 640px) {
        font-size: 2.25rem;
      }
    }

    .last-updated {
      color: #78716C;
      font-size: 0.875rem;
    }
  }

  .content-body {
    color: #44403C;

    p, li {
      font-size: 1rem;
      line-height: 1.75;
      margin-bottom: 1rem;

      @media (min-width: 640px) {
        font-size: 1.0625rem;
      }
    }

    .intro {
      font-size: 1.125rem;
      color: #57534E;
      margin-bottom: 2.5rem;
      text-align: center;
      line-height: 1.8;
    }
  }

  .policy-section {
    margin-bottom: 3rem;

    &:last-child {
      margin-bottom: 0;
    }

    h2 {
      font-size: 1.5rem;
      font-weight: 700;
      color: #8B5E3C;
      margin: 0 0 1.25rem 0;
      line-height: 1.3;

      @media (min-width: 640px) {
        font-size: 1.625rem;
      }
    }
  }

  .custom-list {
    list-style: none;
    padding-left: 0;
    margin: 1.25rem 0;

    li {
      position: relative;
      padding-left: 1.75rem;
      margin-bottom: 1rem;
      line-height: 1.75;

      &:before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.6875rem;
        width: 0.375rem;
        height: 0.375rem;
        background: #8B5E3C;
        border-radius: 50%;
      }

      &:last-child {
        margin-bottom: 0;
      }

      strong {
        color: #292524;
      }

      /* Nested list styling */
      ul {
        list-style: disc;
        padding-left: 2rem;
        margin-top: 0.5rem;
        
        li {
          padding-left: 0.5rem;
          margin-bottom: 0.5rem;
          
          &:before {
            display: none; 
          }
        }
      }
    }
  }

  .note-box {
    margin-top: 3rem;
    font-size: 0.9rem;
    color: #78716C;
    text-align: center;
    border-top: 1px solid #E7E5E4;
    padding-top: 1.5rem;
    font-weight: 600;
  }
</style>